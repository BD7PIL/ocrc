{
  "name": "ocrc-remote",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "OCRC Remote — provision and connect a remote openchamber instance on a controlled Linux host from openchamber",
  "openchamber": {
    "apiVersion": 1,
    "contributes": {
      "panel": {
        "id": "ocrc-remote",
        "name": "OCRC Remote",
        "icon": "link",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "OCRC Remote",
        "height": 96,
        "defaultExpanded": false
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": [
            "ssh"
          ]
        }
      },
      "capabilities": [
        "sessions"
      ],
      "commands": [
        {
          "name": "ocrc-host",
          "description": "把 OCRC 远端主机的现状交给模型（就绪度、引擎、能力缺口）"
        },
        {
          "name": "ocrc-plan",
          "description": "把「连上这台主机还需要装什么」交给模型去安排"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run build:panel && npm run build:status && npm run build:service && node ./scripts/stage-dist.mjs",
    "build:panel": "vite build",
    "build:status": "vite build --config vite.status.config.ts",
    "build:service": "node ./scripts/build-service.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.service.json"
  },
  "dependencies": {
    "@openchamber/sdk": "^2.3.2",
    "@remixicon/react": "^4.9.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.8",
    "@vitejs/plugin-react": "^4.5.2",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
