{
  "name": "ocrc",
  "version": "0.11.5",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "bd7pil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BD7PIL/ocrc.git",
    "directory": "extensions/ocrc"
  },
  "homepage": "https://github.com/BD7PIL/ocrc#readme",
  "bugs": {
    "url": "https://github.com/BD7PIL/ocrc/issues"
  },
  "description": "OCRC — provision and connect a remote openchamber instance on a controlled Linux host from openchamber",
  "openchamber": {
    "apiVersion": 1,
    "contributes": {
      "panel": {
        "id": "ocrc",
        "name": "OCRC",
        "icon": "link",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "OCRC",
        "height": 96,
        "defaultExpanded": true
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": [
            "ssh"
          ]
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:panel && npm run build:status && npm run build:service && node ./scripts/stage-dist.mjs",
    "build:panel": "vite build",
    "build:status": "vite build --config vite.status.config.ts",
    "build:service": "node ./scripts/build-service.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.service.json"
  },
  "dependencies": {
    "@openchamber/sdk": "^2.5.1",
    "@remixicon/react": "^4.9.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.8",
    "@vitejs/plugin-react": "^4.5.2",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
