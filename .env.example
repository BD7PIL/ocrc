# ── ocrc configuration ──────────────────────────────────────────────
# Preferred location: ~/.ocrc/config.env (0600). The plugin also reads
# ./.env (this file) and cwd/.env as lower-priority fallbacks.
# Upstream pre-fork variable names (WEB_PORT, STATE_PATH, ...) keep
# working; the OCRC_* names below take precedence.

# Telegram Bot Token from @BotFather (required)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (required)
ALLOWED_USER_IDS=

# ── Web UI ──────────────────────────────────────────────────────────
# Enable the web transport (serves PWA + WebSocket on OCRC_WEB_HOST:OCRC_WEB_PORT)
OCRC_WEB_ENABLED=true
# LAN-first default (token gate is mandatory and cannot be disabled).
# Set 127.0.0.1 to restrict the console to this machine.
OCRC_WEB_HOST=0.0.0.0
# Pairs with opencode's own server port 4096
OCRC_WEB_PORT=4099
# App token. Leave empty to auto-generate + persist (0600) at ~/.ocrc/token.
OCRC_WEB_TOKEN=
# Static files root (built SvelteKit app)
OCRC_WEB_STATIC_ROOT=web/dist
# Per-session card cache size for WebSocket replay
OCRC_WEB_SESSION_CACHE_SIZE=100

# ── State / misc ────────────────────────────────────────────────────
# Persistent state (lastSessionId, nextAgent, nextModel); default ~/.ocrc/state.json
#OCRC_STATE_PATH=
# Per-chat timeout in ms (default 600000 = 10 min)
CHAT_TIMEOUT_MS=600000
# Log level: debug | info | warn | error
LOG_LEVEL=info
# Mirror prompts into the opencode TUI's prompt buffer (default: true)
TUI_VISIBLE=true
# ── Telegram message pagination limit ──
TG_CHUNK_SOFT_LIMIT=3500

# ── Cloudflare Access (only when OCRC_WEB_AUTH=cf-access) ──────────
#OCRC_WEB_AUTH=token
#OCRC_WEB_CF_ACCESS_TEAM=
#OCRC_WEB_CF_ACCESS_AUD=
# Dev bypass: skip auth — ONLY for a real loopback socket peer. MUST stay
# false behind a Cloudflare Tunnel: cloudflared connects from 127.0.0.1,
# so a loopback bypass would trust ALL tunnel traffic.
#OCRC_WEB_CF_ACCESS_DEV_BYPASS=false
#OCRC_WEB_CF_ACCESS_DEV_EMAIL=dev@localhost
