{
  "name": "@bd7pil/ocrc",
  "version": "2.0.0-alpha.19",
  "description": "Provision and drive remote openchamber instances over ssh: install openchamber (runtime + pinned opencode + app) on a Linux machine that may have no outbound network, relay its egress when it cannot reach a model catalogue, pair it into the desktop app, and keep its config and credentials in sync.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "build:all": "npm run build",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check:coverage": "node scripts/check-coverage.mjs",
    "check:links": "node scripts/check-doc-links.mjs",
    "lint": "biome lint .",
    "preflight": "node scripts/preflight.mjs"
  },
  "bin": {
    "ocrc": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "ops",
    "NOTICE"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^1.6.1",
    "typescript": "^5.9.0",
    "vitest": "^1.6.0"
  },
  "license": "MIT",
  "author": "bd7pil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BD7PIL/ocrc.git"
  },
  "homepage": "https://github.com/BD7PIL/ocrc#readme",
  "bugs": {
    "url": "https://github.com/BD7PIL/ocrc/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "openchamber",
    "opencode",
    "provisioning",
    "ssh",
    "relay",
    "air-gap",
    "remote-instance"
  ],
  "engines": {
    "node": ">=20"
  }
}
