{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"],
    "paths": {
      "$lib/*": ["./src/lib/*"],
      "$shared/*": ["../src/core/*"],
      "@zcode/ui": ["./vendor/zcode/ui/src/index.ts"],
      "@zcode/ui/*": ["./vendor/zcode/ui/src/*"],
      "@zcode/shared": ["./vendor/zcode/shared/src/index.ts"],
      "@zcode/shared/*": ["./vendor/zcode/shared/src/*"],
      "@zcode/services": ["./vendor/zcode/services/src/index.ts"],
      "@zcode/services/*": ["./vendor/zcode/services/src/*"],
      "@zcode/provider": ["./vendor/zcode/provider/src/index.ts"],
      "@zcode/provider/*": ["./vendor/zcode/provider/src/*"],
      "@zcode/rpc": ["./vendor/zcode/rpc/src/index.ts"],
      "@zcode/rpc/*": ["./vendor/zcode/rpc/src/*"],
      "@zcode/zcode-cua": ["./vendor/zcode/cua/index.d.ts"],
      "@zcode/zcode-cua/*": ["./vendor/zcode/cua/*"],
      "@zcode/model-option-map": ["./vendor/zcode/model-option-map/src/index.ts"],
      "@zcode/model-option-map/*": ["./vendor/zcode/model-option-map/src/*"],
      "@/*": ["./vendor/zcode/ui/src/*"],
      "@/WebRemoteControlDialog.js": ["./src/zcode/remoteControl/WebRemoteControlDialog.tsx"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "../src/core/structured-card.ts"]
}
