node_modules/
dist/
.env
*.log
.DS_Store
.vitest-cache/
# opencode workspace config (local model selection + plugin secrets)
config.json
.opencode/
# runtime persisted state (sessionId / agent / model selection)
data/
# deno lock file (project uses Node.js, not Deno)
deno.lock

# code-analysis tool cache — never commit
.understand-anything/

# internal planning/design docs — keep local, don't publish
docs/PRD.md
docs/PRODUCT_STATUS.md
docs/COMPARISON_IM_HUB.md
docs/WEB_DESIGN.md
docs/reviews/
docs/superpowers/
.agent/

# TypeScript incremental build cache — never commit
tsconfig.tsbuildinfo

# brainstorming visual-companion cache
.superpowers/
.pact/
.env.acp

.pact/orchestrate/
.zcode/
.deep-memory/
.omo/

# openchamber extensions: install-time build is NOT supported upstream —
# built artifacts under extensions/*/ must be committed (only node_modules stays out).
!extensions/*/panel/
!extensions/*/status/
!extensions/*/service/
!extensions/*/shared/
coverage/

# control-side artifact caches are runtime state under OCRC_HOME, never in-repo
# (a missing OCRC_HOME used to drop them here as ./bin-cache or ./undefined)
/bin-cache/
/undefined/

# local runs of scripts/build-app-pack.mjs stage the tree and the packs here
/.pack-work-*/
/.packtest/

# 扩展预览构建产物（scripts/preview.mjs 生成，别提交）
extensions/ocrc/.preview-dist/
extensions/ocrc/preview/audit/.chrome-profile/
extensions/ocrc/preview/audit/*.png
